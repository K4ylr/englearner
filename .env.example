# Neon Postgres — from Vercel Integration or Neon dashboard
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Auth.js v5 — generate via `openssl rand -base64 32`
AUTH_SECRET=""

# Resend (https://resend.com) — free tier 3000/month
AUTH_RESEND_KEY=""

# Sender address — use onboarding@resend.dev for initial testing, then your verified domain
EMAIL_FROM="EngLearner <onboarding@resend.dev>"

# Admin secret — protects /api/admin/seed. Generate via `openssl rand -base64 24`.
ADMIN_SECRET=""

# Optional OAuth providers. Missing vars mean the button is hidden.
# Google Cloud Console → OAuth client (Web application)
#   Authorized redirect URI: https://<domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub Settings → Developer settings → OAuth Apps
#   Authorization callback URL: https://<domain>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# YouTube Data API v3 — powers TV/movie scene embeds on the study page.
# Free tier: 10,000 units/day (a search costs 100 units).
# Console: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" on the project first.
YOUTUBE_API_KEY=""
